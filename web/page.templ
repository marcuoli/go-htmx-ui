package web

import "github.com/marcuoli/go-htmx-ui/components/layout"
import "github.com/marcuoli/go-htmx-ui/components/feedback"

templ Page(props PageProps) {
 <!DOCTYPE html>
 <html lang={ pageLanguage(props) }>
  <head>
   <meta charset="utf-8"/>
   <meta name="viewport" content="width=device-width, initial-scale=1"/>
   <title>{ pageTitle(props) }</title>
   @Head(HeadProps{AssetPrefix:props.AssetPrefix, Charts:props.Charts, Nonce:props.Nonce, Interactive:true})
   if props.ExtraHead != nil {
    @props.ExtraHead
   }
   if !props.DisableFrontend {
    @frontendScripts(HeadProps{AssetPrefix:props.AssetPrefix,HTMX:props.HTMX,DisableAlpine:props.DisableAlpine,Nonce:props.Nonce})
   }
  </head>
  <body class="ghtui-document">
   @layout.App(props.App) {
    { children... }
    if !props.DisableToasts {
     @feedback.ToastRegion(feedback.ToastRegionProps{})
    }
   }
  </body>
 </html>
}
