package auth

// AuthStatus renders a closed lock for confirmed sign-in, an open lock for
// confirmed sign-out, and a neutral question icon for unknown state. All three
// fragments remain stable; changing data-auth-state switches icon and text
// together through CSS. The library never infers state from labels or credentials.
templ AuthStatus(props AuthStatusProps) {
 <span class={ "ghtui-auth", templ.KV(props.Class, props.Class != "") } data-auth-state={ string(authState(props.State)) } { props.Attributes... }>
  <span class="ghtui-auth-state" data-auth-part="signed-in">
   <svg class="ghtui-auth-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
   <span class={ "ghtui-auth-label", templ.KV(props.LabelClass, props.LabelClass != "") }>{ authLabel(props.SignedInLabel, "Signed in") }</span>
  </span>
  <span class="ghtui-auth-state" data-auth-part="signed-out">
   <svg class="ghtui-auth-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 7.5-2"></path></svg>
   <span class={ "ghtui-auth-label", templ.KV(props.LabelClass, props.LabelClass != "") }>{ authLabel(props.SignedOutLabel, "Signed out") }</span>
  </span>
  <span class="ghtui-auth-state" data-auth-part="unknown">
   <svg class="ghtui-auth-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4M12 17h.01"></path></svg>
   <span class={ "ghtui-auth-label", templ.KV(props.LabelClass, props.LabelClass != "") }>{ authLabel(props.UnknownLabel, "Authentication unknown") }</span>
  </span>
 </span>
}
