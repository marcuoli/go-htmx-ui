package main

import (
 ui "github.com/marcuoli/go-htmx-ui"
 table "github.com/marcuoli/go-htmx-table"
 versioning "github.com/marcuoli/go-versioning"
)

templ Page(info versioning.Info) {
 <!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Native ECharts component showcase</title><link rel="stylesheet" href="/assets/ui.css"/>
 <style>
 body{margin:0;background:#010409;color:#f0f6fc;font:14px/1.5 system-ui,sans-serif}main{max-width:1800px;margin:auto;padding:32px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.charts{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}.charts[hidden]{display:none}.micro .ghtui-chart-frame:not(.ghtui-chart-compact){height:70px}.micro{grid-template-columns:repeat(4,minmax(0,1fr))}.monitor .ghtui-chart-frame{height:130px}.form{display:grid;gap:18px}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:240px;overflow:auto}.light{background:#f6f8fa;color:#1f2328;--ghtui-surface:#fff;--ghtui-text:#1f2328;--ghtui-muted:#57606a;--ghtui-border:#d0d7de;--ghtui-raised:#eaeef2;--ghtui-accent:#0969da}table{width:100%;border-collapse:collapse}th,td{padding:6px 12px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--ghtui-border,#30363d)}#chart-event-log{display:block;margin:12px 0;font-size:12px;overflow-wrap:anywhere}a{color:var(--ghtui-accent,#79c0ff)}
 </style>
 <script src="/assets/echarts.min.js" defer></script>
 <script src="/assets/echarts-format.js" defer></script>
 <script src="/assets/echarts-ui.js" defer></script>
 </head><body><main>
 @ui.PageHeader(ui.PageHeaderProps{Title:"Native ECharts showcase",Description:"Synthetic native options · no account or production data"}) {
  @ui.Actions() {
   @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"theme-toggle"}}) { Toggle theme }
   @ui.Button(ui.ButtonProps{Attributes:templ.Attributes{"id":"edit-button"}}) { Edit example }
  }
 }
 @ui.VersionLabel(info)
 @ui.Tabs("Example sections") {
  @ui.Tab(ui.TabProps{Label:"Overview",Href:"/",Active:true})
  @ui.Tab(ui.TabProps{Label:"Forms",Href:"#forms"})
 }
 <div class="metrics">
  @ui.WidgetMetric("Requests","123456","Synthetic count")
  @ui.WidgetMetric("Input tokens","682888","Includes cached input")
  @ui.WidgetMetric("Output tokens","16398","Reported usage")
  @ui.WidgetMetric("Estimated value","USD 1234.56 (partial)","Example only")
 </div>
 <div class="charts">
  @ui.Widget(ui.WidgetProps{}) {
   @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Go native option map",Description:"Native series/axes; zero and null stay distinct"}) {
    @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"update-volume"}}) { Update volume }
   }
   @ui.WidgetChart(ui.WidgetChartProps{ID:"volume",Label:"Synthetic native request volume",Option:simpleNativeOption(),Config:ui.EChartsConfig{Tooltip:[]ui.EChartsTooltip{{SeriesID:"volume",Values:[]ui.EChartsTooltipValue{{Format:ui.EChartsValueFormat{Unit:"count"}}}}}},NoScriptNote:"Chart data follows."})
   @ui.WidgetData("Raw input values") { <p>Monday: 0, Tuesday: unavailable, Wednesday: 5. Updates change Wednesday only.</p> }
  }
  @ui.Widget(ui.WidgetProps{Attributes:templ.Attributes{"id":"forms"}}) {
   @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Form controls",Description:"Labels and options use typed props"})
   <div class="form">
    @ui.Field(ui.FieldProps{For:"name",Label:"Display name",Hint:"A synthetic example"}) { @ui.Input(ui.InputProps{ID:"name",Name:"name",Value:"Example application"}) }
    @ui.Field(ui.FieldProps{For:"mode",Label:"Mode"}) { @ui.Select(ui.SelectProps{ID:"mode",Name:"mode",Value:"standard",Options:[]ui.Option{{Value:"standard",Label:"Standard"},{Value:"extended",Label:"Extended"}}}) }
    @ui.Badge() { Ready }
   </div>
  }
 </div>
 @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Native options and live units",Description:"The renderer consumes series/xAxis/yAxis directly. Display bindings never mutate raw data."})
 @ui.Actions() {
  @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"unit-hide"}}) { Hide/show unit plot }
  @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"unit-loading"}}) { Toggle loading }
  @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"unit-empty"}}) { Toggle empty }
  @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"unit-snapshot"}}) { Supply snapshot }
  @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"unit-resize"}}) { Resize unit plot }
  @ui.Field(ui.FieldProps{For:"unit-display",Label:"Display unit"}) {
   @ui.Select(ui.SelectProps{ID:"unit-display",Name:"unit-display",Value:"MiB/h",Options:[]ui.Option{{Value:"MB/s",Label:"MB/s"},{Value:"MiB/s",Label:"MiB/s"},{Value:"Mb/s",Label:"Mb/s"},{Value:"Mib/s",Label:"Mib/s"},{Value:"MiB/h",Label:"MiB/h"},{Value:"MB/min",Label:"MB/min"},{Value:"Gb/d",Label:"Gb/d"},{Value:"auto/h",Label:"Auto /h"}}})
  }
 }
 <output id="chart-event-log">No interaction yet</output>
 for _,example:=range nativeExamples("units") {
  <div id={ example.ID+"-container" }> @NativeExample(example) </div>
 }
 @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Mixed and independent axes",Description:"Stacks, legend grouping, bins, percentile categories and horizontal native axes"})
 <div class="charts">
 for _,example:=range nativeExamples("advanced") {
  @NativeExample(example)
 }
 </div>
 @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"General native families",Description:"Pie/ring, scatter/bubble, heatmap, radar, gauge and stacked area"})
 <div class="charts">
 for _,example:=range nativeExamples("families") {
  @NativeExample(example)
 }
 </div>
 @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Microcharts",Description:"Native options in caller-sized frames"})
 <div class="charts micro">
 for _,example:=range nativeExamples("micro") {
  @NativeExample(example)
 }
 </div>
 @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Monitoring and category labels",Description:"Raw values, explicit IEC units, timezone-aware instants and already-localized categories"})
 <div class="charts monitor">
 for _,example:=range nativeExamples("monitor") {
  @NativeExample(example)
 }
 </div>
 @ui.Widget(ui.WidgetProps{Attributes:templ.Attributes{"id":"initially-hidden","hidden":true}}) {
  @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Initially hidden chart",Description:"Initialized only when a useful size becomes available"})
  @ui.WidgetChart(ui.WidgetChartProps{ID:"hidden-native",Label:"Initially hidden native chart",Option:simpleNativeOption()})
 }
 @ui.Button(ui.ButtonProps{Kind:ui.Secondary,Attributes:templ.Attributes{"id":"show-hidden"}}) { Reveal hidden chart }
 @ui.Widget(ui.WidgetProps{}) {
  @ui.WidgetHeader(ui.WidgetHeaderProps{Title:"Table composition",Description:"Rendered by go-htmx-table"})
  @table.DataTable(table.DataTableProps{ID:"example-table"}) {
 @table.DataTableHead() { @table.Col("Application") @table.Col("Status") @table.Col("Tokens") }
 @table.DataTableBody(table.BodyProps{}) {
 @table.Row() { @table.Cell() { Example A } @table.Cell() { Ready } @table.Cell() { 1.23K } }
 @table.Row() { @table.Cell() { Example B } @table.Cell() { Ready } @table.Cell() { 4.56K } }
 }
 }
 }
 @ui.Dialog(ui.DialogProps{ID:"example-dialog",TitleID:"example-title"}) {
 @ui.DialogHeader(ui.DialogHeaderProps{TitleID:"example-title",Title:"Edit synthetic example"}) {
  <form method="dialog"><button class="ghtui-button-secondary" type="submit">Close</button></form>
 }
 @ui.DialogBody() { <p>Applications own modal actions and form submission.</p> }
 }
 </main><script>
 const chart=()=>document.getElementById('units-network');
 const snapshot=()=>JSON.parse(chart().dataset.uiEcharts);
 const config=()=>JSON.parse(chart().dataset.uiEchartsConfig);
 document.getElementById('theme-toggle').onclick=()=>{document.body.classList.toggle('light');GoHTMXUI.echarts.render();};
 document.getElementById('edit-button').onclick=()=>document.getElementById('example-dialog').showModal();
 document.getElementById('update-volume').onclick=()=>{const host=document.getElementById('volume'),option=JSON.parse(host.dataset.uiEcharts);option.series[0].data[2]++;GoHTMXUI.echarts.update(host,option);};
 document.getElementById('unit-display').onchange=event=>{const c=config(),format={unit:'data-rate',inputUnit:'MB/s',displayUnit:event.target.value,precision:2};c.formats.find(b=>b.target==='yAxis.0.axisLabel.formatter').format=format;c.tooltip[0].values[1].format=format;GoHTMXUI.echarts.update(chart(),snapshot(),c);};
 document.getElementById('unit-hide').onclick=()=>{const parent=document.getElementById('units-network-container');parent.hidden=!parent.hidden;};
 document.getElementById('unit-loading').onclick=()=>{const c=config();c.loading=!c.loading;GoHTMXUI.echarts.update(chart(),snapshot(),c);};
 document.getElementById('unit-empty').onclick=()=>{const c=config();c.empty=!c.empty;GoHTMXUI.echarts.update(chart(),snapshot(),c);};
 document.getElementById('unit-snapshot').onclick=()=>{const option=snapshot();option.series[0].data=option.series[0].data.map(([t,v])=>[t,v===null?null:v+1]);GoHTMXUI.echarts.update(chart(),option);const panel=chart().closest('.ghtui-widget');panel.querySelector('pre').textContent=JSON.stringify(option,null,2);};
 document.getElementById('unit-resize').onclick=()=>{const parent=document.getElementById('units-network-container');parent.style.width=parent.style.width?'':'75%';};
 document.getElementById('show-hidden').onclick=()=>{document.getElementById('initially-hidden').hidden=false;};
 for(const name of ['select','zoom'])document.addEventListener('gohtmxui:chart-'+name,event=>{document.getElementById('chart-event-log').textContent=name+': '+JSON.stringify(event.detail);});
 </script></body></html>
}

templ NativeExample(example chartExample) {
 @ui.Widget(ui.WidgetProps{}) {
  @ui.WidgetHeader(ui.WidgetHeaderProps{Title:example.Title,Description:example.Description})
  @ui.WidgetChart(ui.WidgetChartProps{ID:example.ID,Label:example.Title+" synthetic native chart",Option:example.Option,Config:example.Config,Compact:example.Compact})
  @ui.WidgetData("Raw native options and input values") { <pre>{ rawOption(example.Option) }</pre> }
 }
}
